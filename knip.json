{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "api/*.ts",
    "middleware.ts",
    "src/site/entry-server.ts",
    "src/embed/embed.ts",
    "src/embed/search.ts",
    "scripts/*.mjs",
    "e2e/auth.setup.ts",
    "src/test/setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "api/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "src/**/*.css"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "psql",
    "wp-env"
  ],
  "ignoreIssues": {
    "integrations/**": [
      "unlisted",
      "unresolved",
      "binaries",
      "exports",
      "types"
    ],
    "src/components/ui/**": [
      "exports",
      "types"
    ],
    "src/components/checkin/**": [
      "exports"
    ],
    "src/types/**": [
      "types"
    ],
    "src/features/site-maps/index.ts": [
      "types"
    ],
    "src/queries/**": [
      "exports"
    ],
    "src/components/guards/**": [
      "exports"
    ],
    "src/layouts/ConsoleLayout.tsx": [
      "exports"
    ],
    "src/components/campaigns/CampaignEditor.tsx": [
      "exports"
    ],
    "src/pages/CampaignsPage.tsx": [
      "exports"
    ],
    "src/pages/SegmentsPage.tsx": [
      "exports"
    ]
  },
  "compilers": {
    "css": true
  }
}
