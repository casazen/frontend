{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "api/*.ts",
    "middleware.ts",
    "src/site/entry-server.ts",
    "scripts/*.mjs",
    "e2e/auth.setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "api/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "src/**/*.css"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "psql"
  ],
  "ignoreIssues": {
    "src/components/ui/**": [
      "exports",
      "types"
    ],
    "src/components/checkin/**": [
      "exports"
    ],
    "src/types/**": [
      "types"
    ],
    "src/queries/**": [
      "exports"
    ],
    "src/components/guards/**": [
      "exports"
    ],
    "src/layouts/ConsoleLayout.tsx": [
      "exports"
    ]
  },
  "compilers": {
    "css": true
  }
}
