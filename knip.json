{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "api/*.ts",
    "middleware.ts",
    "src/site/entry-server.ts",
    "src/embed/embed.ts",
    "src/embed/search.ts",
    "scripts/*.mjs",
    "e2e/auth.setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "api/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "src/**/*.css"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "psql",
    "wp-env"
  ],
  "ignoreIssues": {
    "integrations/**": [
      "unlisted"
    ],
    "src/components/checkin/AccessCodeDisplay.tsx": [
      "exports"
    ],
    "src/queries/ownerPortal.ts": [
      "exports"
    ],
    "src/types/condition.ts": [
      "types"
    ]
  },
  "compilers": {
    "css": true
  }
}
