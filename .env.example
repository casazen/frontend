# Every variable of every environment (Vercel Preview/Production, local) with its effect when missing:
# backend docs/runbooks/deploy-checklist.md section 4. A Vercel Preview/Production build FAILS without
# VITE_API_BASE_URL, VITE_AUTH0_DOMAIN, VITE_AUTH0_CLIENT_ID and VITE_AUTH0_AUDIENCE (src/config/vercel-build-env.ts).
# env-example.test.ts keeps this file and the code in sync.
#
# Auth0 Configuration: test application, test API (audience) and test database connection of the Auth0 tenant, never the
# production ones (backend docs/runbooks/auth0.md section 1). The tenant may be shared with production: the application
# and the API identifier are what separate the environments. Required: there is no default tenant in code.
VITE_AUTH0_DOMAIN=<login domain of the Auth0 tenant>
VITE_AUTH0_CLIENT_ID=<client id of the TEST SPA application>
VITE_AUTH0_AUDIENCE=https://casazen-api

# API Configuration
# Local product testing (Vite + Casazen.Web on this machine):
VITE_API_BASE_URL=http://localhost:5000/api
# Shared test API (Expo Go / remote):
# VITE_API_BASE_URL=https://casazen-api-test.up.railway.app/api
# Production:
# VITE_API_BASE_URL=https://casazen-api.up.railway.app/api

# Public domain of the web app (SE-02, backend docs/runbooks/seo-domain.md): robots.txt declares the sitemap on it.
# Same value as the backend App__PublicSiteBaseUrl. Required only by a Vercel Production build (VERCEL_ENV=production);
# every other build writes a robots.txt with "Disallow: /".
# VITE_PUBLIC_SITE_URL=https://<public domain>

# Support e-mail shown on the "account disabled" page (PL-03) and as the contact of the public site (SEO-VETRINA).
# Optional: without it the page shows a generic text and the public site shows no e-mail.
# VITE_SUPPORT_EMAIL=<support address>

# Company data of the public site (SEO-VETRINA, backend docs/runbooks/seo-domain.md §11): footer of every page and JSON-LD
# Organization of the home page. On Vercel Production the site is served only with name and partita IVA (the partita IVA
# must be on the home page, art. 35 DPR 633/1972); elsewhere a missing value is simply not shown.
# VITE_LEGAL_NAME=<ragione sociale>
# VITE_LEGAL_VAT_ID=<partita IVA, 11 digits>
# VITE_LEGAL_ADDRESS=<sede legale>
# Publish the public site on production WITHOUT a partita IVA (the company does not exist yet): needs VITE_LEGAL_NAME (holder)
# and VITE_SUPPORT_EMAIL (contact) and the advice of an accountant or a lawyer first. Never on by default.
# VITE_PUBLIC_SITE_WITHOUT_VAT_ID=true

# Plausible analytics for the SEO funnel (SE-04, backend docs/runbooks/seo-funnel.md). Optional: when set, the app also
# calls window.plausible() for the funnel events (the script itself is added by the product owner). Without it nothing
# is sent to a third party; the events still reach the CasaZen API.
# VITE_PLAUSIBLE_DOMAIN=<domain registered on Plausible>

# Demo Mode: only for `npm run dev:demo` / `npm run build:demo`; `npm run build` fails if this is true
VITE_DEMO_MODE=false
# Demo profile of `npm run dev:demo` (short-stay | long-term | dual | onboarding | admin | triple | supplier; default long-term: src/config/demo.config.ts). Local only.
# VITE_DEMO_PROFILE=long-term

# Dev server over HTTPS (phone/LAN Auth0 needs Web Crypto). 1 = on. Read by vite.config.ts from the shell environment.
# VITE_HTTPS=1
# Copy this file to .env and fill in your values
