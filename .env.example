# Auth0 Configuration: a development/test tenant, never the production one (backend docs/runbooks/auth0.md section 1).
# Required: there is no default tenant in code.
VITE_AUTH0_DOMAIN=<login domain of your development/test Auth0 tenant>
VITE_AUTH0_CLIENT_ID=<SPA client id of that tenant>
VITE_AUTH0_AUDIENCE=https://casazen-api

# API Configuration
# Local product testing (Vite + Casazen.Web on this machine):
VITE_API_BASE_URL=http://localhost:5000/api
# Shared test API (Expo Go / remote):
# VITE_API_BASE_URL=https://casazen-api-test.up.railway.app/api
# Production:
# VITE_API_BASE_URL=https://casazen-api.up.railway.app/api

# Public domain of the web app (SE-02, backend docs/runbooks/seo-domain.md): robots.txt declares the sitemap on it.
# Same value as the backend App__PublicSiteBaseUrl. Required only by a Vercel Production build (VERCEL_ENV=production);
# every other build writes a robots.txt with "Disallow: /".
# VITE_PUBLIC_SITE_URL=https://<public domain>

# Support e-mail shown on the "account disabled" page (PL-03). Optional: without it the page shows a generic text.
# VITE_SUPPORT_EMAIL=<support address>

# Demo Mode: only for `npm run dev:demo` / `npm run build:demo`; `npm run build` fails if this is true
VITE_DEMO_MODE=false
# Copy this file to .env and fill in your values
