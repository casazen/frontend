{
	"name": "casazen-wordpress-plugin",
	"version": "0.1.0",
	"private": true,
	"description": "Development tooling of the CasaZen WordPress plugin. Not shipped in the plugin ZIP.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks/src --output-path=blocks/build",
		"start": "wp-scripts start --webpack-src-dir=blocks/src --output-path=blocks/build",
		"lint:php-syntax": "node tools/check-php-syntax.mjs",
		"check:version": "node tools/check-version.mjs",
		"check:translations": "node tools/check-translations.mjs",
		"zip": "node tools/build-zip.mjs",
		"test:tools": "node --test tools/package.test.mjs"
	},
	"devDependencies": {
		"@wordpress/env": "^12.2.0",
		"@wordpress/scripts": "^26.19.0",
		"archiver": "^8.0.0",
		"php-parser": "^3.7.0"
	}
}
