#: blocks/src/booking/block.json
msgctxt "block title"
msgid "CasaZen booking"
msgstr "Prenotazione CasaZen"

#: blocks/src/booking/block.json
msgctxt "block description"
msgid "Shows the CasaZen booking engine: search, results and quote."
msgstr "Mostra il motore di prenotazione CasaZen: ricerca, risultati e preventivo."

#: blocks/src/guest-access/block.json
msgctxt "block title"
msgid "CasaZen guest access"
msgstr "Accesso ospiti CasaZen"

#: blocks/src/guest-access/block.json
msgctxt "block description"
msgid "Lets your guests open and manage their booking."
msgstr "Permette ai tuoi ospiti di aprire e gestire la prenotazione."

#: blocks/src/owner-login/block.json
msgctxt "block title"
msgid "CasaZen owner login"
msgstr "Accesso proprietari CasaZen"

#: blocks/src/owner-login/block.json
msgctxt "block description"
msgid "Shows a link to the sign-in of the owner area. The owner area is never shown inside a frame."
msgstr "Mostra un link all'accesso dell'area proprietari. L'area proprietari non viene mai mostrata dentro un riquadro incorporato."

#: blocks/src/property/block.json
msgctxt "block title"
msgid "CasaZen property"
msgstr "Alloggio CasaZen"

#: blocks/src/property/block.json
msgctxt "block description"
msgid "Shows one property of your CasaZen site with its availability and quote."
msgstr "Mostra un alloggio del tuo sito CasaZen con disponibilità e preventivo."

#: blocks/src/search/block.json
msgctxt "block title"
msgid "CasaZen search bar"
msgstr "Barra di ricerca CasaZen"

#: blocks/src/search/block.json
msgctxt "block description"
msgid "Shows the search bar of CasaZen (place, dates and guests) and leads to the page with the booking engine."
msgstr "Mostra la barra di ricerca di CasaZen (luogo, date e ospiti) e porta alla pagina con il motore di prenotazione."

#: blocks/src/shared/placeholder-edit.js:35
msgid "Language"
msgstr "Lingua"

#: blocks/src/shared/placeholder-edit.js:36
msgid "The default follows the language of the page and the language mapping of the plugin settings."
msgstr "Il valore predefinito segue la lingua della pagina e l'associazione delle lingue nelle impostazioni del plugin."

#: blocks/src/shared/placeholder-edit.js:41 blocks/src/shared/placeholder-edit.js:140
msgid "Default"
msgstr "Predefinito"

#: blocks/src/shared/placeholder-edit.js:42
msgid "Italian"
msgstr "Italiano"

#: blocks/src/shared/placeholder-edit.js:43
msgid "English"
msgstr "Inglese"

#: blocks/src/shared/placeholder-edit.js:46
msgid "Automatic (read from the page by the browser)"
msgstr "Automatica (la legge dalla pagina il browser)"

#: blocks/src/shared/placeholder-edit.js:52
msgid "Property slug"
msgstr "Slug dell'alloggio"

#: blocks/src/shared/placeholder-edit.js:53
msgid "The last part of the address of the property on your CasaZen site, for example villa-rossa."
msgstr "L'ultima parte dell'indirizzo dell'alloggio sul tuo sito CasaZen, ad esempio villa-rossa."

#: blocks/src/shared/placeholder-edit.js:60
msgid "Check-in date"
msgstr "Data di arrivo"

#: blocks/src/shared/placeholder-edit.js:61 blocks/src/shared/placeholder-edit.js:66
msgid "Written as YYYY-MM-DD. Leave empty to let the guest choose."
msgstr "Scritta come AAAA-MM-GG. Lascia vuoto per far scegliere all'ospite."

#: blocks/src/shared/placeholder-edit.js:65
msgid "Check-out date"
msgstr "Data di partenza"

#: blocks/src/shared/placeholder-edit.js:70
msgid "Guests"
msgstr "Ospiti"

#: blocks/src/shared/placeholder-edit.js:71
msgid "A number from 1 to 30. Leave empty to let the guest choose."
msgstr "Un numero da 1 a 30. Lascia vuoto per far scegliere all'ospite."

#: blocks/src/shared/placeholder-edit.js:77 includes/class-admin.php:459
msgid "Booking page"
msgstr "Pagina di prenotazione"

#: blocks/src/shared/placeholder-edit.js:78
msgid "Where the search leads: a path of this site, an address of this site or an https address. Leave empty to use the page that holds the booking engine."
msgstr "Dove porta la ricerca: un percorso di questo sito, un indirizzo di questo sito o un indirizzo https. Lascia vuoto per usare la pagina che contiene il motore di prenotazione."

#: blocks/src/shared/placeholder-edit.js:85
msgid "Places"
msgstr "Luoghi"

#: blocks/src/shared/placeholder-edit.js:86
msgid "Offers the places of your properties in the search bar."
msgstr "Mostra nella barra di ricerca i luoghi dei tuoi alloggi."

#: blocks/src/shared/placeholder-edit.js:88 blocks/src/shared/placeholder-edit.js:163
msgid "Yes"
msgstr "Sì"

#: blocks/src/shared/placeholder-edit.js:89 blocks/src/shared/placeholder-edit.js:163
msgid "No"
msgstr "No"

#: blocks/src/shared/placeholder-edit.js:94
msgid "Most guests"
msgstr "Numero massimo di ospiti"

#: blocks/src/shared/placeholder-edit.js:95
msgid "The most guests the search bar accepts, from 1 to 99."
msgstr "Il numero massimo di ospiti che la barra di ricerca accetta, da 1 a 99."

#: blocks/src/shared/placeholder-edit.js:101
msgid "Send events to the data layer"
msgstr "Invia gli eventi al data layer"

#: blocks/src/shared/placeholder-edit.js:102
msgid "Reports searches, views and the start of a checkout to the data layer of the page (Google Tag Manager)."
msgstr "Segnala ricerche, visualizzazioni e avvio del checkout al data layer della pagina (Google Tag Manager)."

#: blocks/src/shared/placeholder-edit.js:109
msgid "Keep the state in the address of the page"
msgstr "Mantieni lo stato nell'indirizzo della pagina"

#: blocks/src/shared/placeholder-edit.js:110
msgid "Adds a cz parameter to the address of the page while the guest browses the widget."
msgstr "Aggiunge il parametro cz all'indirizzo della pagina mentre l'ospite usa il widget."

#: blocks/src/shared/placeholder-edit.js:117
msgid "Initial height (pixels)"
msgstr "Altezza iniziale (pixel)"

#: blocks/src/shared/placeholder-edit.js:118
msgid "A number from 100 to 2000. The widget then adapts its height to its content."
msgstr "Un numero da 100 a 2000. Poi il widget adatta la sua altezza al contenuto."

#: blocks/src/shared/placeholder-edit.js:127
msgid "Main colour"
msgstr "Colore principale"

#: blocks/src/shared/placeholder-edit.js:128
msgid "A colour written as #rgb or #rrggbb, for example #2b4c7e."
msgstr "Un colore scritto come #rgb o #rrggbb, ad esempio #2b4c7e."

#: blocks/src/shared/placeholder-edit.js:132
msgid "Corner radius"
msgstr "Raggio degli angoli"

#: blocks/src/shared/placeholder-edit.js:133
msgid "A whole number with px (up to 32px) or rem (up to 2rem), for example 8px."
msgstr "Un numero intero con px (fino a 32px) o rem (fino a 2rem), ad esempio 8px."

#: blocks/src/shared/placeholder-edit.js:137
msgid "Font"
msgstr "Carattere"

#: blocks/src/shared/placeholder-edit.js:138
msgid "One of the fonts of your CasaZen booking site."
msgstr "Uno dei caratteri del tuo sito di prenotazione CasaZen."

#: blocks/src/shared/placeholder-edit.js:141
msgid "Editorial"
msgstr "Editoriale"

#: blocks/src/shared/placeholder-edit.js:142
msgid "Modern"
msgstr "Moderno"

#: blocks/src/shared/placeholder-edit.js:143
msgid "Classic"
msgstr "Classico"

#: blocks/src/shared/placeholder-edit.js:148
msgid "Text of the link"
msgstr "Testo del link"

#: blocks/src/shared/placeholder-edit.js:149
msgid "Leave empty to use the default text."
msgstr "Lascia vuoto per usare il testo predefinito."

#: blocks/src/shared/placeholder-edit.js:274 includes/class-admin.php:164 includes/class-admin.php:364
msgid "Settings"
msgstr "Impostazioni"

#: blocks/src/shared/placeholder-edit.js:277
msgid "Appearance"
msgstr "Aspetto"

#: blocks/src/shared/placeholder-edit.js:285
msgid "This is only a preview. The widget appears on the published page."
msgstr "Questa è solo un'anteprima. Il widget appare sulla pagina pubblicata."

#. Plugin Name of the plugin
#: casazen.php:3 casazen.php:9
msgid "CasaZen"
msgstr "CasaZen"

#. Description of the plugin
#: casazen.php:5
msgid "Connects your WordPress site to CasaZen, so that your booking engine and your guest area appear on your own pages."
msgstr "Collega il tuo sito WordPress a CasaZen, per mostrare il motore di prenotazione e l'area ospite sulle tue pagine."

#: includes/class-admin.php:111
msgid "Connection"
msgstr "Connessione"

#: includes/class-admin.php:117
msgid "CasaZen address"
msgstr "Indirizzo CasaZen"

#: includes/class-admin.php:125
msgid "Organisation slug"
msgstr "Identificativo dell'organizzazione (slug)"

#: includes/class-admin.php:134
msgid "Display"
msgstr "Visualizzazione"

#: includes/class-admin.php:140
msgid "Language mapping"
msgstr "Associazione delle lingue"

#: includes/class-admin.php:148
msgid "Script"
msgstr "Script"

#: includes/class-admin.php:187
msgid "Set the CasaZen address to start using the plugin."
msgstr "Imposta l'indirizzo CasaZen per iniziare a usare il plugin."

#: includes/class-admin.php:199 includes/class-wizard.php:161 includes/class-wizard.php:171
msgid "You do not have permission to do this."
msgstr "Non hai il permesso di eseguire questa azione."

#: includes/class-admin.php:228
msgid "You do not have permission to open this page."
msgstr "Non hai il permesso di aprire questa pagina."

#: includes/class-admin.php:256
msgid "The address where your CasaZen booking site lives. The widgets are loaded by the browser of your visitors straight from this address."
msgstr "L'indirizzo del tuo sito di prenotazione CasaZen. I widget vengono caricati dal browser dei tuoi visitatori direttamente da questo indirizzo."

#: includes/class-admin.php:273
msgid "The address of your CasaZen booking site, for example https://prenota.example.com. Only the scheme, the host and the port are kept."
msgstr "L'indirizzo del tuo sito di prenotazione CasaZen, ad esempio https://prenota.example.com. Vengono conservati solo lo schema, il dominio e la porta."

#: includes/class-admin.php:292
msgid "Only needed when the address above is the CasaZen domain. Lower-case letters, numbers and hyphens."
msgstr "Serve solo quando l'indirizzo qui sopra è il dominio di CasaZen. Lettere minuscole, numeri e trattini."

#: includes/class-admin.php:310
msgid "One line per language of your site, for example it_IT = it. The value is it, en or auto."
msgstr "Una riga per ogni lingua del tuo sito, ad esempio it_IT = it. Il valore è it, en oppure auto."

#: includes/class-admin.php:325
msgid "Load the CasaZen script on the pages that use it"
msgstr "Carica lo script di CasaZen nelle pagine che lo usano"

#: includes/class-admin.php:365 includes/class-admin.php:417
msgid "Guided setup"
msgstr "Procedura guidata"

#: includes/class-admin.php:398 includes/class-admin.php:403
msgid "Test connection"
msgstr "Prova la connessione"

#: includes/class-admin.php:399
msgid "Check now that this site can reach your CasaZen address."
msgstr "Controlla ora che questo sito riesca a raggiungere il tuo indirizzo CasaZen."

#: includes/class-admin.php:418
msgid "Creates the pages of your booking site and adds them to a menu. A page that already exists is never changed, and nothing is deleted or moved."
msgstr "Crea le pagine del tuo sito di prenotazione e le aggiunge a un menu. Una pagina che esiste già non viene mai modificata e non viene cancellato né spostato nulla."

#. translators: %s: the date and time of the last run of the guided setup.
#: includes/class-admin.php:427
#, php-format
msgid "Last run: %s."
msgstr "Ultima esecuzione: %s."

#: includes/class-admin.php:441 includes/class-admin.php:550
msgid "Run the connection test first"
msgstr "Esegui prima la prova della connessione"

#: includes/class-admin.php:442
msgid "Open the Settings tab"
msgstr "Apri la scheda Impostazioni"

#: includes/class-admin.php:460
msgid "Guest access page"
msgstr "Pagina di accesso degli ospiti"

#: includes/class-admin.php:461
msgid "Owner area page"
msgstr "Pagina dell'area proprietari"

#: includes/class-admin.php:478 includes/class-admin.php:481
msgid "Pages"
msgstr "Pagine"

#: includes/class-admin.php:490
msgid "Title"
msgstr "Titolo"

#. translators: %s: the title of the page that already exists, as a link.
#: includes/class-admin.php:498
#, php-format
msgid "A page for this already exists: %s. It will not be changed."
msgstr "Esiste già una pagina per questo: %s. Non verrà modificata."

#: includes/class-admin.php:510
msgid "Publication"
msgstr "Pubblicazione"

#: includes/class-admin.php:514
msgid "Publish the pages now"
msgstr "Pubblica subito le pagine"

#: includes/class-admin.php:516
msgid "Without the tick the pages are saved as drafts."
msgstr "Senza la spunta le pagine vengono salvate come bozze."

#: includes/class-admin.php:520
msgid "Menu"
msgstr "Menu"

#: includes/class-admin.php:523
msgid "Do not add menu entries"
msgstr "Non aggiungere voci di menu"

#: includes/class-admin.php:528
msgid "The pages are added at the end of the menu. The entries that are already there are never moved, renamed or removed."
msgstr "Le pagine vengono aggiunte in fondo al menu. Le voci già presenti non vengono mai spostate, rinominate o rimosse."

#: includes/class-admin.php:530
msgid "Your theme is a block theme: its menus are edited in the Site Editor. If you choose no menu here, the pages are listed so that you can add them there."
msgstr "Il tuo tema è un tema a blocchi: i suoi menu si modificano nell'Editor del sito. Se qui non scegli nessun menu, le pagine vengono elencate così potrai aggiungerle lì."

#: includes/class-admin.php:535
msgid "Create the pages"
msgstr "Crea le pagine"

#: includes/class-admin.php:549
msgid "The menu you chose does not exist. Nothing was created."
msgstr "Il menu scelto non esiste. Non è stato creato nulla."

#: includes/class-admin.php:559
msgid "The setup is done."
msgstr "La procedura è terminata."

#. translators: %s: the name of a menu.
#: includes/class-admin.php:573
#, php-format
msgid "Menu: %s"
msgstr "Menu: %s"

#: includes/class-admin.php:579
msgid "Your theme is a block theme, so no menu was changed. Add them to the Navigation block in the Site Editor."
msgstr "Il tuo tema è un tema a blocchi, quindi nessun menu è stato modificato. Aggiungile al blocco Navigazione nell'Editor del sito."

#: includes/class-admin.php:582
msgid "The pages are in the default language. Translate the pages from the Polylang screen."
msgstr "Le pagine sono nella lingua predefinita. Traduci le pagine dalla schermata di Polylang."

#: includes/class-admin.php:600
msgid "Skipped."
msgstr "Saltata."

#: includes/class-admin.php:603
msgid "The page could not be created."
msgstr "Non è stato possibile creare la pagina."

#: includes/class-admin.php:611
msgid "Page created."
msgstr "Pagina creata."

#: includes/class-admin.php:613
msgid "It is a draft: publish it when you are ready."
msgstr "È una bozza: pubblicala quando sei pronto."

#. translators: 1: the address the title asked for, 2: the address the page got.
#: includes/class-admin.php:618
#, php-format
msgid "The address \"%1$s\" belongs to another page, so this page uses \"%2$s\"."
msgstr "L'indirizzo \"%1$s\" appartiene a un'altra pagina, quindi questa pagina usa \"%2$s\"."

#: includes/class-admin.php:624
msgid "The page already exists and was not changed."
msgstr "La pagina esiste già e non è stata modificata."

#: includes/class-admin.php:628
msgid "Added to the menu."
msgstr "Aggiunta al menu."

#: includes/class-admin.php:630
msgid "Already in the menu."
msgstr "Già presente nel menu."

#: includes/class-admin.php:632
msgid "Could not be added to the menu."
msgstr "Non è stato possibile aggiungerla al menu."

#: includes/class-admin.php:647
msgid "Hero search bar"
msgstr "Barra di ricerca della home"

#. translators: 1: the shortcode of the search bar. 2: the title of the page that holds the booking engine.
#: includes/class-admin.php:652
#, php-format
msgid "Add the shortcode %1$s to the home page (in Elementor, the Shortcode widget): it sends the guest to the page %2$s with the dates and the guests."
msgstr "Aggiungi lo shortcode %1$s alla home page (in Elementor, il widget Shortcode): porta l'ospite alla pagina %2$s con le date e gli ospiti."

#: includes/class-admin.php:717
msgid "Connection status"
msgstr "Stato della connessione"

#: includes/class-admin.php:719
msgid "No check has been made yet. Use the Test connection button below."
msgstr "Non è ancora stata fatta nessuna verifica. Usa il pulsante «Prova la connessione» qui sotto."

#: includes/class-admin.php:724
msgid "Agency"
msgstr "Agenzia"

#: includes/class-admin.php:728
msgid "Embedding"
msgstr "Incorporamento"

#: includes/class-admin.php:732
msgid "Owner sign-in"
msgstr "Accesso dei proprietari"

#: includes/class-admin.php:736
msgid "Last check"
msgstr "Ultima verifica"

#: includes/class-admin.php:742
msgid "Script address"
msgstr "Indirizzo dello script"

#: includes/class-admin.php:757
msgid "On"
msgstr "Attivo"

#: includes/class-admin.php:760
msgid "Off"
msgstr "Non attivo"

#: includes/class-admin.php:762 includes/class-admin.php:778
msgid "Unknown"
msgstr "Sconosciuto"

#: includes/class-admin.php:773
msgid "Ready"
msgstr "Pronto"

#: includes/class-admin.php:776
msgid "Not ready yet"
msgstr "Non ancora pronto"

#: includes/class-connection.php:282
msgid "The connection works."
msgstr "La connessione funziona."

#: includes/class-connection.php:284
msgid "The connection works, but embedding is not switched on for your agency yet. Ask your CasaZen contact to switch it on."
msgstr "La connessione funziona, ma l'incorporamento non è ancora attivo per la tua agenzia. Chiedi al tuo referente CasaZen di attivarlo."

#: includes/class-connection.php:286
msgid "The address could not be reached. Check that it is correct and that the site is online."
msgstr "L'indirizzo non è raggiungibile. Controlla che sia corretto e che il sito sia online."

#: includes/class-connection.php:288
msgid "The address answered, but it is not a CasaZen address that supports embedding. Check the address."
msgstr "L'indirizzo ha risposto, ma non è un indirizzo CasaZen che supporta l'incorporamento. Controlla l'indirizzo."

#: includes/class-connection.php:290
msgid "CasaZen did not answer the check as expected. Try again in a few minutes."
msgstr "CasaZen non ha risposto alla verifica come previsto. Riprova tra qualche minuto."

#: includes/class-connection.php:292
msgid "CasaZen does not know this address or this organisation slug. Check how they are written."
msgstr "CasaZen non conosce questo indirizzo o questo identificativo. Controlla come sono scritti."

#: includes/class-connection.php:294
msgid "Set the CasaZen address to start."
msgstr "Imposta l'indirizzo CasaZen per iniziare."

#: includes/class-renderer.php:198
msgid "CasaZen: set the address in Settings → CasaZen"
msgstr "CasaZen: imposta l'indirizzo in Impostazioni → CasaZen"

#: includes/class-renderer.php:209
msgid "CasaZen: embedding is not enabled for this agency yet."
msgstr "CasaZen: l'incorporamento non è ancora attivo per questa agenzia."

#: includes/class-renderer.php:217
msgid "CasaZen: the property widget needs the slug of a property, for example slug=\"villa-rossa\"."
msgstr "CasaZen: il widget della scheda alloggio richiede lo slug di un alloggio, ad esempio slug=\"villa-rossa\"."

#: includes/class-renderer.php:231
msgid "CasaZen — the booking engine appears on the published page"
msgstr "CasaZen — il motore di prenotazione appare sulla pagina pubblicata"

#. translators: %s: the host name of the CasaZen address, for example prenota.example.com.
#: includes/class-renderer.php:533
#, php-format
msgid "Manage your booking on %s"
msgstr "Gestisci la tua prenotazione su %s"

#. translators: %s: the host name of the CasaZen address, for example prenota.example.com.
#: includes/class-renderer.php:535
#, php-format
msgid "Book on %s"
msgstr "Prenota su %s"

#: includes/class-renderer.php:552
msgid "CasaZen: the owner portal is not enabled for this agency yet."
msgstr "CasaZen: il portale proprietari non è ancora attivo per questa agenzia."

#: includes/class-renderer.php:557 includes/class-wizard.php:95
msgid "Owner area"
msgstr "Area proprietari"

#: includes/class-settings.php:202
msgid "The organisation slug is not valid: use lower-case letters, numbers and single hyphens, up to 100 characters. The previous value was kept."
msgstr "L'identificativo dell'organizzazione non è valido: usa lettere minuscole, numeri e trattini singoli, fino a 100 caratteri. Il valore precedente è stato mantenuto."

#. translators: %s: the first lines of the language mapping that were ignored.
#: includes/class-settings.php:221
#, php-format
msgid "Some lines of the language mapping were ignored because they are not valid: %s"
msgstr "Alcune righe dell'associazione delle lingue sono state ignorate perché non valide: %s"

#: includes/class-settings.php:443
msgid "The CasaZen address must start with https://. The previous address was kept."
msgstr "L'indirizzo CasaZen deve iniziare con https://. L'indirizzo precedente è stato mantenuto."

#: includes/class-settings.php:445
msgid "Only https addresses are accepted (http works only for local development hosts). The previous address was kept."
msgstr "Sono accettati solo indirizzi https (http funziona solo sui domini di sviluppo locale). L'indirizzo precedente è stato mantenuto."

#: includes/class-settings.php:447
msgid "The CasaZen address must not contain a user name or a password. The previous address was kept."
msgstr "L'indirizzo CasaZen non deve contenere nome utente o password. L'indirizzo precedente è stato mantenuto."

#: includes/class-settings.php:449
msgid "The CasaZen address is not valid. Use the form https://prenota.example.com. The previous address was kept."
msgstr "L'indirizzo CasaZen non è valido. Usa il formato https://prenota.example.com. L'indirizzo precedente è stato mantenuto."

#: includes/class-wizard.php:93
msgid "Book"
msgstr "Prenota"

#: includes/class-wizard.php:94
msgid "Online check-in"
msgstr "Check-in online"
